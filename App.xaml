<Application x:Class="SmartClipVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="FontSizeBase">12</sys:Double>
            <sys:Double x:Key="FontSize12">12</sys:Double>
            <sys:Double x:Key="FontSize11">11</sys:Double>
            <sys:Double x:Key="FontSize10">10</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
