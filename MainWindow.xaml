<Window x:Class="SmartClipVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SmartClipVault" Height="600" Width="900"
        Background="#1E1E1E" Foreground="#D4D4D4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClipItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#264F78"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#37373D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar: Backup / Restore / Language -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#252526" Padding="8,5" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackupButton" Content="{DynamicResource Btn_Backup}" Style="{StaticResource DarkButton}"
                        Margin="0,0,4,0" Click="OnBackupClick"/>
                <Button x:Name="RestoreButton" Content="{DynamicResource Btn_Restore}" Style="{StaticResource DarkButton}"
                        Margin="0,0,12,0" Click="OnRestoreClick"/>
                <Button Content="{DynamicResource Btn_LangEN}" Style="{StaticResource DarkButton}"
                        Margin="0,0,2,0" Click="OnLangEnClick"/>
                <Button Content="{DynamicResource Btn_LangVI}" Style="{StaticResource DarkButton}"
                        Click="OnLangViClick"/>
            </StackPanel>
        </Border>

        <!-- Left column: Search + Clipboard History -->
        <DockPanel Grid.Row="1" Grid.Column="0" Background="#1E1E1E">
            <Border DockPanel.Dock="Top" Background="#252526" Padding="8,6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="{DynamicResource Main_ClipboardHistory}" Foreground="#9CDCFE" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                                 TextChanged="OnSearchChanged"/>
                        <TextBlock Text="{DynamicResource Main_SearchPlaceholder}"
                                   Foreground="#555"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
            <ListBox x:Name="ClipListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnClipDoubleClick"
                     SelectionChanged="OnClipSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Preview}" FontSize="12"
                                           Foreground="{Binding PreviewColor}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Preview}"/>
                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#808080"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Clip_Copy}" Style="{StaticResource DarkButton}"
                                    Margin="4,0,2,0" FontSize="10"
                                    Tag="{Binding}"
                                    Click="OnCopyClipClick"/>
                            <Button Grid.Column="2" Content="{DynamicResource Clip_Pin}" Style="{StaticResource DarkButton}"
                                    Margin="2,0,0,0" FontSize="10"
                                    Tag="{Binding}"
                                    Click="OnPinClipClick"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="#3A3A3A" HorizontalAlignment="Stretch"/>

        <!-- Right column: Boards + AI Templates -->
        <DockPanel Grid.Row="1" Grid.Column="2" Background="#252526">
            <!-- Board selector -->
            <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock Text="{DynamicResource Main_Boards}" Foreground="#9CDCFE" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Main_NewBoard}" Style="{StaticResource DarkButton}"
                            FontSize="10" Click="OnCreateBoardClick"/>
                </DockPanel>
            </Border>
            <ListBox x:Name="BoardListBox"
                     DockPanel.Dock="Top"
                     MaxHeight="140"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource BoardItemStyle}"
                     SelectionChanged="OnBoardSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="12"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Pinned clips for selected board -->
            <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4" BorderBrush="#3A3A3A" BorderThickness="0,1,0,1">
                <TextBlock x:Name="PinnedLabel" Text="{DynamicResource Main_PinnedClips}" Foreground="#808080" FontSize="11"/>
            </Border>
            <ListBox x:Name="PinnedClipListBox"
                     DockPanel.Dock="Top"
                     MaxHeight="160"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ClipItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnPinnedClipDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Preview}" FontSize="12"
                                   Foreground="{Binding PreviewColor}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Preview}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- AI Prompt Templates -->
            <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="8,4" BorderBrush="#3A3A3A" BorderThickness="0,1,0,1">
                <TextBlock Text="{DynamicResource Main_AITemplates}" Foreground="#808080" FontSize="11"/>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="6">
                <Button DockPanel.Dock="Bottom" Content="{DynamicResource Main_RunTemplate}" Style="{StaticResource DarkButton}"
                        Margin="0,4,0,0" Click="OnRunTemplateClick"/>
                <TextBox x:Name="TemplateBox" Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="80" VerticalScrollBarVisibility="Auto"
                         Text="Summarize: {{clip}}"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
