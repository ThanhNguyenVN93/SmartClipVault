<Window x:Class="SmartClipVault.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Background="#E6252526"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,8"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#x2714;" Foreground="#38BDF8" FontSize="13" FontWeight="Bold"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="MessageText" Text="Copied!" Foreground="#F3F4F6"
                       FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
