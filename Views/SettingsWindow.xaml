<Window x:Class="SmartClipVault.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="#D4D4D4"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource FontSizeBase}">
    <Window.Resources>
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#264F78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#D4D4D4"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,4,22,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D2D"
                                            BorderThickness="1"
                                            BorderBrush="#555">
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkPinBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="CaretBrush" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to Defaults" Style="{StaticResource DarkButton}"
                    Margin="0,0,12,0" Click="OnResetDefaultsClick"/>
            <Button x:Name="SaveButton" Content="{DynamicResource Settings_Save}" Style="{StaticResource DarkButton}"
                    IsDefault="True" Margin="0,0,8,0" Click="OnSaveClick"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Settings_Cancel}" Style="{StaticResource DarkButton}"
                    IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>

        <TabControl Background="#1E1E1E" BorderBrush="#3A3A3A" Foreground="#D4D4D4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#D4D4D4"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="#3A3A3A"
                                        BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="3,3,0,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#264F78"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource Settings_AutoStart}"
                              ToolTip="{DynamicResource Tip_Settings_AutoStart}" Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="StartHiddenCheck" Content="{DynamicResource Settings_StartHidden}"
                              ToolTip="{DynamicResource Tip_Settings_StartHidden}" Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="DoubleClickTrayCheck" Content="{DynamicResource Settings_DoubleClickTray}"
                              ToolTip="{DynamicResource Tip_Settings_DoubleClickTray}" Style="{StaticResource DarkCheck}"/>

                    <TextBlock Text="{DynamicResource Settings_FontScale}" Style="{StaticResource DarkLabel}" Margin="0,10,0,4"/>
                    <ComboBox x:Name="FontScaleCombo" Style="{StaticResource DarkCombo}" Width="110" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="0.9" Content="90%"/>
                        <ComboBoxItem Tag="1.0" Content="100%"/>
                        <ComboBoxItem Tag="1.1" Content="110%"/>
                        <ComboBoxItem Tag="1.25" Content="125%"/>
                    </ComboBox>

                    <TextBlock Text="Language" Style="{StaticResource DarkLabel}" Margin="0,10,0,4"/>
                    <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkCombo}" Width="130" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="en" Content="English"/>
                        <ComboBoxItem Tag="vi" Content="Tiếng Việt"/>
                    </ComboBox>

                    <TextBlock Text="Theme" Style="{StaticResource DarkLabel}" Margin="0,10,0,4"/>
                    <ComboBox x:Name="ThemeCombo" Style="{StaticResource DarkCombo}" Width="130" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="Dark" Content="Dark"/>
                        <ComboBoxItem Tag="Light" Content="Light"/>
                        <ComboBoxItem Tag="System" Content="System"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Clipboard">
                <StackPanel Margin="12">
                    <CheckBox x:Name="CaptureHistoryCheck" Content="{DynamicResource Settings_CaptureHistory}"
                              ToolTip="{DynamicResource Tip_Settings_CaptureHistory}" Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="AutoStarCheck" Content="{DynamicResource Settings_AutoStar}"
                              ToolTip="{DynamicResource Tip_Settings_AutoStar}" Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="PlayToastSoundCheck" Content="Play sound on Toast notifications"
                              Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="EnableOcrCheck" Content="Enable automatic OCR for images"
                              Style="{StaticResource DarkCheck}"/>

                    <TextBlock Text="Max history items" Style="{StaticResource DarkLabel}" Margin="0,10,0,4"/>
                    <ComboBox x:Name="MaxHistoryCombo" Style="{StaticResource DarkCombo}" Width="130" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="500" Content="500"/>
                        <ComboBoxItem Tag="1000" Content="1000"/>
                        <ComboBoxItem Tag="5000" Content="5000"/>
                        <ComboBoxItem Tag="0" Content="Unlimited"/>
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Security">
                <StackPanel Margin="12">
                    <TextBlock Text="{DynamicResource Settings_ExcludedApps}" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="ExcludedAppsBox" Style="{StaticResource DarkTextBox}"
                             ToolTip="{DynamicResource Tip_Settings_ExcludedApps}"
                             Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

                    <TextBlock Text="{DynamicResource Settings_AutoClearDays}" Style="{StaticResource DarkLabel}"/>
                    <TextBox x:Name="AutoClearDaysBox" Style="{StaticResource DarkTextBox}"
                             ToolTip="{DynamicResource Tip_Settings_AutoClearDays}" Width="80" HorizontalAlignment="Left"/>

                    <TextBlock Text="Auto-lock after inactivity" Style="{StaticResource DarkLabel}" Margin="0,8,0,4"/>
                    <ComboBox x:Name="AutoLockCombo" Style="{StaticResource DarkCombo}" Width="130" HorizontalAlignment="Left">
                        <ComboBoxItem Tag="0" Content="Disabled"/>
                        <ComboBoxItem Tag="5" Content="5 minutes"/>
                        <ComboBoxItem Tag="15" Content="15 minutes"/>
                        <ComboBoxItem Tag="30" Content="30 minutes"/>
                    </ComboBox>

                    <Button Content="Clear All Unpinned History..." Style="{StaticResource DarkButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnClearHistoryClick"/>

                    <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0"
                            ToolTip="{DynamicResource Tip_Settings_PinLock}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_PinLock_Header}" Style="{StaticResource DarkLabel}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PinStatusText" Style="{StaticResource DarkLabel}" Foreground="#808080" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Settings_PinNew}" Style="{StaticResource DarkLabel}"/>
                            <PasswordBox x:Name="NewPinBox" MaxLength="8" Style="{StaticResource DarkPinBox}"/>
                            <TextBlock Text="{DynamicResource Settings_PinConfirm}" Style="{StaticResource DarkLabel}"/>
                            <PasswordBox x:Name="ConfirmPinBox" MaxLength="8" Style="{StaticResource DarkPinBox}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{DynamicResource Settings_PinSet}" Style="{StaticResource DarkButton}"
                                        Margin="0,0,6,0" Click="OnSetPinClick"/>
                                <Button x:Name="RemovePinButton" Content="{DynamicResource Settings_PinRemove}" Style="{StaticResource DarkButton}"
                                        Click="OnRemovePinClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Backup &amp; Updates">
                <StackPanel Margin="12">
                    <CheckBox x:Name="IncludeImagesCheck" Content="{DynamicResource Settings_IncludeImagesInBackup}"
                              ToolTip="{DynamicResource Tip_Settings_IncludeImages}" Style="{StaticResource DarkCheck}"/>
                    <CheckBox x:Name="AutoBackupBeforeRestoreCheck" Content="{DynamicResource Settings_AutoBackupBeforeRestore}"
                              ToolTip="{DynamicResource Tip_Settings_AutoBackup}" Style="{StaticResource DarkCheck}"/>

                    <TextBlock Text="Data &amp; Sync Folder (e.g. OneDrive / Google Drive):" Style="{StaticResource DarkLabel}" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DataDirectoryBox" Grid.Column="0" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource DarkButton}" Margin="6,0,0,0" Click="OnBrowseDataDirClick"/>
                    </Grid>

                    <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="SmartClipVault" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,6"/>
                            <Button Content="Check for Updates..." Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Left" Click="OnCheckUpdatesClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
