<Window x:Class="SmartClipVault.Views.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPaste"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Height"
        Width="420"
        Background="#1E1E1E"
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        FontSize="{DynamicResource FontSizeBase}">
    <Window.Resources>
        <Style x:Key="ClipRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#264F78"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="#252526" Padding="8,6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1"
                Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x1F4CB;" ToolTip="Open SmartClipVault" Padding="5,2" Margin="0,0,4,0"
                            Background="#2D2D30" Foreground="#D4D4D4" BorderThickness="0" Cursor="Hand"
                            FontSize="11" Click="OnOpenMainClick"/>
                    <Button Content="&#x2699;" ToolTip="Settings" Padding="5,2"
                            Background="#2D2D30" Foreground="#D4D4D4" BorderThickness="0" Cursor="Hand"
                            FontSize="12" Click="OnOpenSettingsClick"/>
                </StackPanel>
                <TextBlock Text="Quick Paste  —  1-9 to paste · Esc to close"
                           Foreground="#808080" FontSize="{DynamicResource FontSize11}" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border Background="#1E1E1E" Padding="8,5" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="#252526"
                         Foreground="#D4D4D4"
                         BorderBrush="#3A3A3A"
                         CaretBrush="#D4D4D4"
                         Padding="6,3"
                         FontSize="{DynamicResource FontSize12}"
                         TextChanged="OnSearchBoxTextChanged"
                         PreviewKeyDown="OnSearchBoxPreviewKeyDown"/>
                <TextBlock Text="{DynamicResource QuickPaste_SearchPlaceholder}"
                           Foreground="#555"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Border Background="#202022" Padding="8,4" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FilterAllButton" Content="{DynamicResource Filter_All}"
                        Margin="0,0,4,0" Padding="8,3" FontSize="{DynamicResource FontSize11}"
                        Background="#264F78" Foreground="#D4D4D4" BorderThickness="0" Cursor="Hand"
                        Click="OnFilterAllClick"/>
                <Button x:Name="FilterTextButton" Content="{DynamicResource Filter_Text}"
                        Margin="0,0,4,0" Padding="8,3" FontSize="{DynamicResource FontSize11}"
                        Background="#2D2D30" Foreground="#D4D4D4" BorderThickness="0" Cursor="Hand"
                        Click="OnFilterTextClick"/>
                <Button x:Name="FilterImagesButton" Content="{DynamicResource Filter_Images}"
                        Padding="8,3" FontSize="{DynamicResource FontSize11}"
                        Background="#2D2D30" Foreground="#D4D4D4" BorderThickness="0" Cursor="Hand"
                        Click="OnFilterImagesClick"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="EmptyText"
                   Text="No clips available"
                   Foreground="#808080"
                   FontSize="{DynamicResource FontSize12}"
                   Padding="10,12"
                   Visibility="Collapsed"/>
        <ListBox x:Name="ClipList"
                 Background="Transparent"
                 BorderThickness="0"
                 MaxHeight="460"
                 IsTextSearchEnabled="False"
                 ItemContainerStyle="{StaticResource ClipRowStyle}"
                 MouseDoubleClick="OnMouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                Background="#37373D" VerticalAlignment="Top" Margin="0,2,8,0">
                            <TextBlock Text="{Binding Index}" Foreground="#9CDCFE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}" FontWeight="Bold"/>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="4" Background="#1E1E1E" BorderBrush="#3A3A3A"
                                    BorderThickness="1" Padding="4" Visibility="{Binding ImageVisibility}">
                                <Image Source="{Binding Thumbnail}" MaxHeight="130" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="{Binding Preview}"/>
                            </Border>
                            <TextBlock Grid.Row="0" Text="{Binding Preview}" Foreground="#D4D4D4"
                                       FontSize="{DynamicResource FontSize12}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding Preview}"
                                       Visibility="{Binding TextVisibility}"/>
                            <TextBlock Grid.Row="1" Text="{Binding MetaInfo}" Foreground="#606060"
                                       FontSize="10" Margin="0,2,0,0"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
