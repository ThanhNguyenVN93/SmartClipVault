<Window x:Class="SmartClipVault.Views.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPaste"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SizeToContent="Height"
        Width="420"
        Background="#1E1E1E"
        BorderBrush="#3A3A3A"
        BorderThickness="1">
    <Window.Resources>
        <Style x:Key="ClipRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#264F78"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="#252526" Padding="8,6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <TextBlock Text="Quick Paste  —  1-9 to paste · Esc to close"
                       Foreground="#808080" FontSize="11" FontFamily="Segoe UI"/>
        </Border>
        <TextBlock x:Name="EmptyText"
                   Text="No clips available"
                   Foreground="#808080"
                   FontSize="12"
                   Padding="10,12"
                   Visibility="Collapsed"/>
        <ListBox x:Name="ClipList"
                 Background="Transparent"
                 BorderThickness="0"
                 MaxHeight="380"
                 IsTextSearchEnabled="False"
                 ItemContainerStyle="{StaticResource ClipRowStyle}"
                 MouseDoubleClick="OnMouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="#569CD6"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Preview}" Foreground="#D4D4D4"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="{Binding Preview}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
