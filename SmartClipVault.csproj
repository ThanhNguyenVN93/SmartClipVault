<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyTitle>SmartClipVault</AssemblyTitle>
    <Product>SmartClipVault</Product>
    <Description>Privacy-first Windows 11 Clipboard Manager, Prompt Vault, and Offline OCR Utility</Description>
    <Company>ThanhNguyenVN93</Company>
    <Copyright>Copyright © 2026 ThanhNguyenVN93</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);SelfTest\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
